// Prisma schema for GemFitness Gym Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - Members and Staff
model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  phone              String         @unique
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  address            String?
  emergencyContact   String
  emergencyPhone     String
  fitnessGoals       String?
  medicalConditions  String?
  password           String
  role               UserRole       @default(MEMBER)
  qrCode             String?        @unique // Unique QR code for member check-in
  registrationPaid   Boolean        @default(false) // One-time registration fee (GH₵ 250)
  registrationType   RegistrationType @default(SELF) // SELF, WALK_IN, or ADMIN
  paymentReference   String?        // Reference for registration payment
  profileImage       String?        // Profile image URL
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  
  // Relations
  subscriptions Subscription[]
  checkIns      CheckIn[]
  notifications Notification[]
  classBookings ClassBooking[]
  eventBookings EventBooking[]

  @@index([email])
  @@index([phone])
  @@index([qrCode])
  @@map("users")
}

enum UserRole {
  MEMBER
  RECEPTIONIST
  MANAGER
  ADMIN
}

enum RegistrationType {
  SELF           // Self-registration
  WALK_IN        // Walk-in at gym
  ADMIN          // Registered by admin
}

// Subscription model - Membership plans
model Subscription {
  id            String             @id @default(cuid())
  userId        String
  plan          MembershipPlan
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @default(now())
  endDate       DateTime
  amount        Float
  registrationType RegistrationType @default(SELF)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  // Relations
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

enum MembershipPlan {
  ONE_MONTH      // GH₵ 200
  THREE_MONTHS   // GH₵ 500
  ONE_YEAR       // GH₵ 2200
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// CheckIn model - Track member attendance
model CheckIn {
  id           String   @id @default(cuid())
  userId       String
  checkInTime  DateTime @default(now())
  checkOutTime DateTime?
  checkedBy    String?  // Staff member who processed check-in
  method       String   @default("qr") // "qr" or "manual"
  notes        String?  // Additional notes
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checkInTime])
  @@map("check_ins")
}

// Payment model - Transaction records
model Payment {
  id               String         @id @default(cuid())
  subscriptionId   String
  amount           Float
  paymentMethod    String         @default("CARD")
  paymentDate      DateTime
  reference        String         @unique // Paystack reference
  status           PaymentStatus  @default(PENDING)
  paystackResponse Json?          // Store full webhook data
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  // Relations
  subscription     Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([reference])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

// Notification model - Email notification logs
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  subject   String
  message   String
  sentAt    DateTime?
  status    String           @default("pending") // "pending", "sent", "failed"
  createdAt DateTime         @default(now())
  
  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("notifications")
}

enum NotificationType {
  WELCOME
  PAYMENT_SUCCESS
  EXPIRY_WARNING    // 3 days before expiry
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_RENEWED
}

// Class model - Gym classes/sessions
model Class {
  id            String         @id @default(cuid())
  name          String
  description   String?
  type          String         // "Cardio", "HIIT", "Weight Training", "Dance", etc.
  instructor    String
  duration      Int            // Duration in minutes
  maxCapacity   Int            @default(20)
  currentBookings Int          @default(0)  // Current number of bookings
  schedule      String         // "Mon, Wed, Fri - 6:30 AM"
  color         String?        // Gradient color for UI
  status        ClassStatus    @default(ACTIVE)
  createdBy     String         // Manager who created the class
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  bookings      ClassBooking[]

  @@index([status])
  @@index([type])
  @@map("classes")
}

enum ClassStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

// ClassBooking model - Member class bookings
model ClassBooking {
  id          String   @id @default(cuid())
  userId      String
  classId     String
  bookedFor   DateTime // When the class is scheduled
  status      String   @default("confirmed") // "confirmed", "cancelled", "attended"
  createdAt   DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([classId])
  @@index([bookedFor])
  @@map("class_bookings")
}

// Event model - Special events (workshops, competitions, etc.)
model Event {
  id            String         @id @default(cuid())
  title         String
  description   String
  eventDate     DateTime
  endDate       DateTime?
  location      String?        @default("GemFitness Tema")
  image         String?        // Event banner/poster URL
  maxAttendees  Int?           // Null = unlimited
  isFree        Boolean        @default(true)
  price         Float?         // Event ticket price if not free
  status        EventStatus    @default(UPCOMING)
  createdBy     String         // Staff member who created event
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Relations
  bookings      EventBooking[]

  @@index([status])
  @@index([eventDate])
  @@map("events")
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// EventBooking model - Member event registrations
model EventBooking {
  id          String   @id @default(cuid())
  userId      String
  eventId     String
  status      String   @default("registered") // "registered", "cancelled", "attended"
  createdAt   DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@map("event_bookings")
}

// Plan model - Membership plan templates
model Plan {
  id              String             @id @default(cuid())
  name            String             @unique // "Monthly", "Quarterly", "Annual", custom names
  slug            String             @unique // "ONE_MONTH", "THREE_MONTHS", "ONE_YEAR"
  description     String?
  price           Float              // Price in GH₵
  duration        Int                // Duration in days
  durationUnit    String             @default("days") // "days", "months", "years"
  currency        String             @default("GH₵")
  features        String[]           // Array of feature descriptions
  status          PlanStatus         @default(ACTIVE)
  isPopular       Boolean            @default(false)
  isFeatured      Boolean            @default(false)
  displayOrder    Int                @default(0)
  createdBy       String             // Admin who created the plan
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  
  // Relations
  changeHistory   PlanChangeHistory[]

  @@index([status])
  @@index([slug])
  @@map("plans")
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// PlanChangeHistory model - Track plan modifications
model PlanChangeHistory {
  id              String   @id @default(cuid())
  planId          String
  changedBy       String   // Admin who made the change
  changeType      String   // "CREATED", "UPDATED", "PRICE_CHANGED", "STATUS_CHANGED"
  oldValue        String?  // JSON string of old values
  newValue        String?  // JSON string of new values
  description     String?  // Human-readable change description
  createdAt       DateTime @default(now())
  
  // Relations
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([changedBy])
  @@map("plan_change_history")
}

// RegistrationFee model - Dynamic registration fees
model RegistrationFee {
  id          String   @id @default(cuid())
  type        String   @unique // "SINGLE", "COUPLE", "FAMILY"
  name        String   // Display name: "Single", "Couple", "Family"
  price       Float    // Price in GH₵
  description String?  // Description text
  maxMembers  Int?     // NULL for single, 2 for couple, 5 for family
  status      String   @default("ACTIVE") // "ACTIVE" or "INACTIVE"
  currency    String   @default("GH₵")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@map("registration_fees")
}
